# URL du backend qui appelle l'API Anthropic (jamais la clé API dans l'app mobile).
# Voir eveil-app-spec.md §5 et §7. Sans cette variable, les écrans IA affichent
# un message d'erreur doux au lieu de planter.
EXPO_PUBLIC_API_URL=https://eveil-backend.onrender.com

# Projet Supabase (Project Settings > API Keys dans le dashboard Supabase).
# L'anon key est une clé PUBLIQUE conçue pour être dans l'app (la sécurité
# vient des policies RLS côté base), donc pas de risque à la mettre ici.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
