# Copie ce fichier en .env et renseigne ta vraie clé (jamais commitée).
ANTHROPIC_API_KEY=sk-ant-...

# Optionnel
PORT=3000
ANTHROPIC_MODEL=claude-sonnet-5
# Origine(s) autorisée(s) à appeler ce serveur, séparées par des virgules.
# Laisser vide en dev (autorise tout) ; à restreindre en production.
ALLOWED_ORIGIN=

# Nécessaires uniquement pour `npm run send-daily-notifications` (job cron).
# SUPABASE_URL : Project Settings > API dans le dashboard Supabase.
# SUPABASE_SERVICE_ROLE_KEY : même page, clé secrète (jamais dans l'app mobile).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
