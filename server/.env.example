# Copie ce fichier en .env et renseigne ta vraie clé (jamais commitée).
ANTHROPIC_API_KEY=sk-ant-...

# Optionnel
PORT=3000
ANTHROPIC_MODEL=claude-sonnet-5
# Origine(s) autorisée(s) à appeler ce serveur, séparées par des virgules.
# Laisser vide en dev (autorise tout) ; à restreindre en production.
ALLOWED_ORIGIN=

# SUPABASE_URL : Project Settings > API dans le dashboard Supabase (publique).
# Sert à vérifier les comptes qui appellent /api/ai, et au job cron `npm run send-daily-notifications`.
SUPABASE_URL=
# Secours uniquement pour la vérification des comptes (clé "anon" / publishable, publique).
SUPABASE_ANON_KEY=
# Nécessaire uniquement pour `npm run send-daily-notifications` (job cron) : clé secrète, jamais dans l'app mobile.
SUPABASE_SERVICE_ROLE_KEY=

# Contrôle de l'abonnement côté serveur (clé secrète v1 RevenueCat : Project settings > API keys). Optionnel.
REVENUECAT_SECRET_KEY=
# true : jeton de compte obligatoire, ancien format refusé. À n'activer qu'une fois la nouvelle app approuvée.
AI_STRICT=
